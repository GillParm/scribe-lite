# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Without keys the bundled samples still work: they use the scripted transcripts
# and precomputed notes.

# Anthropic: SOAP note generation and the hallucination check.
ANTHROPIC_API_KEY=
# Google AI Studio: transcription of new audio (free tier is enough for the demo).
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# DATABASE_URL=postgresql+psycopg://scribe:scribe@localhost:5434/scribe
# DATA_DIR=data
# SOAP_MODEL=claude-opus-5-5
# SOAP_EFFORT=medium
# CHECK_MODEL=claude-opus-5-5
# CHECK_EFFORT=medium
# TRANSCRIBER=auto
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# RETENTION_DAYS=30
# RETENTION_INTERVAL_MINUTES=60
